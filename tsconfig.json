{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"rootDir": "src",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"outDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noImplicitAny": true,
		"useUnknownInCatchVariables": true,
   		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true
	}
}